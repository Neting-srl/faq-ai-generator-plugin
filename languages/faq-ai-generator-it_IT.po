#. Description of the plugin
#: faq-ai-generator.php
msgid "Automatically generate FAQs for your WordPress content using artificial intelligence."
msgstr "Genera automaticamente FAQ per i tuoi contenuti WordPress utilizzando l'intelligenza artificiale."

#: includes/class-faq-ai-generator-api.php:751
msgid "The request took too long. Please try again later."
msgstr "La richiesta ha impiegato troppo tempo. Per favore riprova più tardi."

#: includes/class-faq-ai-generator-models.php:25
msgid "Extended version of GPT-3.5 with a larger context, ideal for long content"
msgstr "Versione estesa di GPT-3.5 con contesto più ampio, ideale per contenuti lunghi"

#: includes/class-faq-ai-generator-models.php:31
msgid "Extended version of GPT-4 with a much larger context, great for in-depth analysis"
msgstr "Versione estesa di GPT-4 con contesto molto ampio, ottimo per analisi approfondite"

#: includes/class-faq-ai-generator-models.php:37
msgid "Optimized version of GPT-4 for faster performance and large context"
msgstr "Versione ottimizzata di GPT-4 per prestazioni più veloci e contesto ampio"

#: includes/class-faq-ai-generator-models.php:43
msgid "Stable version of GPT-4 with excellent balance between quality and context"
msgstr "Versione stabile di GPT-4 con ottimo bilanciamento tra qualità e contesto"

#: includes/class-faq-ai-generator-models.php:49
msgid "Mini version of GPT-4o for fast performance and reduced costs"
msgstr "Versione mini di GPT-4o per prestazioni veloci e costi ridotti"

#: includes/class-faq-ai-generator-models.php:55
msgid "Stable version of GPT-4.1 with a very large context, great for in-depth analysis"
msgstr "Versione stabile di GPT-4.1 con contesto molto ampio, ottimo per analisi approfondite"
